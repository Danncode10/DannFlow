{
  "name": "my-structure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "checkpoint": "bash scripts/checkpoint.sh",
    "db:generate": "npx supabase db diff -f",
    "db:migrate": "npx supabase db push",
    "db:setup": "npx supabase start",
    "db:pull": "npx supabase db pull",
    "db:compare": "npx supabase db diff --linked",
    "db:types": "npx supabase gen types typescript --local > src/types/supabase.ts",
    "db:types:remote": "npx supabase gen types typescript --linked > src/types/supabase.ts",
    "setup": "npm run setup:env && npm run setup:ruflo && npm run setup:skills",
    "setup:env": "node -e \"const fs=require('fs');!fs.existsSync('.env.local')&&fs.copyFileSync('.env.example','.env.local');console.log('✅ .env.local ready');\"",
    "setup:ruflo": "npm install -g ruflo@latest && npx ruflo@latest init wizard",
    "setup:skills": "npx -y skills add https://github.com/Leonxlnx/taste-skill --all && npx -y skills add https://github.com/emilkowalski/skill --all && npx -y skills add https://github.com/pbakaus/impeccable --all && npx -y skills add anthropics/skills@claude-api -y && npx -y skills add shadcn/ui@shadcn -y && npx -y skills add alirezarezvani/claude-skills@a11y-audit -y && npx -y skills add coreyhaines31/marketingskills --all && npx -y skills add addyosmani/web-quality-skills@seo -y",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/react": "^4.0.102",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.101.1",
    "@tanstack/react-query": "^5.102.0",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-youtube": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "ai": "^7.0.99",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.10",
    "motion": "^13.2.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intersection-observer": "^10.0.3",
    "sonner": "^2.0.8",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "use-stick-to-bottom": "^1.1.6",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^6",
    "vitest": "^5.0.0"
  }
}
