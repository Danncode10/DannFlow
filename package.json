    "@tiptap/starter-kit": "^3.30.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.41.0",
    "lucide-react": "^1.33.0",
    "marked": "^18.0.10",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intersection-observer": "^10.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
