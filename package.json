    "marked": "^14.1.4",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-intersection-observer": "^10.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
