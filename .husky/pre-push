npm run lint
npx tsc --noEmit

# Check pending docs before pushing to main
while read local_ref local_oid remote_ref remote_oid
do
  if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/master" ]]; then
    if [ -f "docs/PENDING_DOC_UPDATES.md" ]; then
      # Extract real pending lines (ignoring empty lines, comment blocks, and markdown title headers)
      PENDING_ENTRIES=$(sed '/<!--/,/-->/d' docs/PENDING_DOC_UPDATES.md | grep -v '^[[:space:]]*$' | grep -v '^[[:space:]]*#[[:space:]]*' || true)
      if [ -n "$PENDING_ENTRIES" ]; then
        echo ""
        echo "🚨 MERGE BLOCKED: You have pending documentation updates in docs/PENDING_DOC_UPDATES.md"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "$PENDING_ENTRIES"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "👉 Action Required: Transfer these notes into docs/ and docs/diagrams/ (or prune if reverted), then clear them from docs/PENDING_DOC_UPDATES.md before pushing to main."
        echo ""
        exit 1
      fi
    fi
  fi
done
