# Supabase Configuration
# Get these from Supabase Dashboard > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qrstuvwxyz
SUPABASE_SERVICE_ROLE_KEY=sb_secret_aabbccddeeffgghhiijj
SUPABASE_PROJECT_ID=abcdefghijklmnop
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.abcdefghijklmnop.supabase.co:5432/postgres

# Durable Rate Limiting (server-side only; do not prefix with NEXT_PUBLIC_)
# Create these in Upstash Redis > your database > REST API.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Site Branding
NEXT_PUBLIC_SITE_NAME=DannFlow
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Danncode10

# Admin Access
# Optional comma-separated allowlist. Users with profiles.role = admin for this app also pass.
SUPER_ADMIN_EMAILS=admin@example.com

# Blog publishing helper
# Optional path/origin overrides used by scripts/publish-blog-post.mjs.
BLOG_ADMIN_ORIGIN=http://localhost:3000
BLOG_PUBLIC_ORIGIN=http://localhost:3000
BLOG_ADMIN_EDIT_PATH_TEMPLATE=/dashboard/blog/{id}
BLOG_PUBLIC_BASE_PATH=/blog
BLOG_POSTS_TABLE=blog_posts
BLOG_POST_ORGANIZATION_ID=
BLOG_POST_EXTRA_COLUMNS=image_alt_text,image_caption,pexels_credit_url,primary_keyword,search_intent,internal_links,facebook_caption,reddit_discussion_prompt,seo_quality_score,pre_publish_warnings

# Social Publishing (server-side only; do not prefix with NEXT_PUBLIC_)
# Facebook posts are published to a Facebook Page through the Meta Graph API.
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_PAGE_ID=123456789012345
FACEBOOK_PAGE_ACCESS_TOKEN=EAAB...

# Reddit posts are submitted through OAuth using a refresh token.
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_REFRESH_TOKEN=your-reddit-refresh-token
REDDIT_USER_AGENT=DannFlow/1.0 by your_reddit_username
REDDIT_USERNAME=your_reddit_username
REDDIT_SUBREDDIT=your_target_subreddit
