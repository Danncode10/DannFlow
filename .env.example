# ============================================================================
# VERCEL: COPY EVERY VARIABLE IN THIS BLOCK TO VERCEL → Production
# ============================================================================
# Enter the values from your private .env.local; never upload the file itself.
# For the FIRST deployment, use the current NEXT_PUBLIC_SITE_URL value. After
# Vercel gives you its stable HTTPS URL, replace only NEXT_PUBLIC_SITE_URL with
# that URL and redeploy.

# Supabase runtime — get these from Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_qrstuvwxyz
# Server-only: never rename this to NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_aabbccddeeffgghhiijj

# Rate limiting runtime — get these from Upstash Redis → REST API.
# Server-only: never add a NEXT_PUBLIC_ prefix.
# Create these in Upstash Redis > your database > REST API.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Site runtime
NEXT_PUBLIC_SITE_NAME=DannFlow
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Danncode10

# ============================================================================
# STOP — DO NOT COPY ANYTHING BELOW THIS LINE TO VERCEL
# These values are for local development, controlled CI, and task tracking.
# ============================================================================

# Local/CI database maintenance only
SUPABASE_PROJECT_ID=abcdefghijklmnop
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.abcdefghijklmnop.supabase.co:5432/postgres

# DannFlow-template contribution validation only. Set these in a project .env.local
# before /sync-to-upstream when it detects a schema change. They must target a dedicated disposable
# DannFlow template verification database, never the source project or production.
DANNFLOW_TEMPLATE_SUPABASE_PROJECT_ID=abcdefghijklmnop
DANNFLOW_TEMPLATE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.abcdefghijklmnop.supabase.co:5432/postgres

# Local task tracking only
# Paste the canonical board URL after creating it. This is not a secret.
# Use /users/<owner>/projects/<number> or /orgs/<owner>/projects/<number>; omit /views/... query strings.
GITHUB_PROJECT_URL=https://github.com/users/your-github-owner/projects/1
# Optional compatibility/API values. Agents derive these from GITHUB_PROJECT_URL and persist the API ID when needed.
GITHUB_PROJECT_OWNER=your-github-owner
GITHUB_PROJECT_NUMBER=1
GITHUB_PROJECT_ID=PVT_kwDOExample
